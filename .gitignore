# ============================================================
# CampusStream Helper - Git 忽略规则
# 目标：绝不把虚拟环境、构建产物、日志、备份和本机隐私信息推上 GitHub
# ============================================================

# ---------- Python 字节码与缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 测试 / 类型检查 / 格式化缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------- PyInstaller 构建产物 ----------
build/
dist/
*.spec
*.manifest
# 打包配置属于源码，必须提交（放在 packaging/ 下）
!packaging/*.manifest
!packaging/*.spec

# ---------- 运行日志与自动备份（可能含设备 ID / IP，禁止上传） ----------
*.log
logs/
*.bak
*.bak.*
backup/
runtime/
state/

# ---------- 本地配置与密钥 ----------
.env
.env.*
!.env.example
config.local.*
*.pem
*.key

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Windows ----------
Thumbs.db
Desktop.ini

# ---------- macOS（协作者可能使用） ----------
.DS_Store
